{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vimo",
  "version": "../package.json",
  "identifier": "click.vimo.portable",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm run fetch:binaries && pnpm run build:sidecar && pnpm run dev",
    "beforeBuildCommand": "pnpm run fetch:binaries && pnpm run build:sidecar && pnpm run build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["vimo"]
      }
    },
    "updater": {
      "endpoints": ["https://vimo.click/releases/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQUY3ODYxMDRGRDk3NTgKUldSWWwvMEVZWGl2YmFvRVpyT25GbkY3NEFnenYrSzl4b1BVV0VoVGhxa1dxaEFydlF1eUhXanEK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "Vimo",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Vimo",
    "externalBin": [
      "binaries/vimo-pipeline",
      "binaries/ffmpeg",
      "binaries/yt-dlp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
